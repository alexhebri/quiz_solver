{
  "manifest_version": 3,
  "name": "Hebri Oracle Quiz Solver",
  "version": "1.0.0",
  "description": "Solve Oracle Academy quiz questions one at a time using OpenRouter.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://openrouter.ai/*"],
  "action": {
    "default_title": "Hebri Oracle Quiz Solver",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
